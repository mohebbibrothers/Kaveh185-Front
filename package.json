{
  "name": "kaveh185-front",
  "version": "0.1.0",
  "private": true,
  "description": "فرانت‌اند سامانهٔ مسابقهٔ کتابخوانی هفتهٔ بسیج — کاوه ۱۸۵ (حوزهٔ ۱۸۵ شهید کاوه)",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "pack:front": "node scripts/pack-frontend.mjs",
    "pack:front:dir": "node scripts/pack-frontend.mjs --no-tar",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm run typecheck:ts5",
    "typecheck:ts5": "tsc --noEmit -p tsconfig.json",
    "typecheck:ts7": "typescript-7 --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "api:types": "node scripts/gen-api.mjs",
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "budget": "node scripts/check-budget.mjs",
    "verify": "pnpm run tokens:check && pnpm run api:types -- --check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run budget",
    "inspect:host": "node scripts/inspect-host.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "motion": "14.14.0",
    "next": "16.4.6",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.51.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.0",
    "@vitest/coverage-v8": "3.2.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.6",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-7": "npm:typescript@7.0.2",
    "typescript-eslint": "8.72.2",
    "vitest": "3.2.4"
  },
  "browserslist": [
    "chrome >= 105",
    "edge >= 105",
    "firefox >= 102",
    "safari >= 15.6",
    "ios_saf >= 15.6",
    "samsung >= 20",
    "and_chr >= 105",
    "not dead",
    "not op_mini all"
  ]
}
